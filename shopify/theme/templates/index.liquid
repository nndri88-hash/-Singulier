              <input type="checkbox" id="fp-rubis" name="pierres" value="Rubis"><label for="fp-rubis">Rubis</label>
              <input type="checkbox" id="fp-emeraude" name="pierres" value="Émeraude"><label for="fp-emeraude">Émeraude</label>
              <input type="checkbox" id="fp-spinelle" name="pierres" value="Spinelle"><label for="fp-spinelle">Spinelle</label>
              <input type="checkbox" id="fp-tourmaline" name="pierres" value="Tourmaline"><label for="fp-tourmaline">Tourmaline</label>
              <input type="checkbox" id="fp-tanzanite" name="pierres" value="Tanzanite"><label for="fp-tanzanite">Tanzanite</label>
              <input type="checkbox" id="fp-aigue" name="pierres" value="Aigue-marine"><label for="fp-aigue">Aigue-marine</label>
              <input type="checkbox" id="fp-peridot" name="pierres" value="Péridot"><label for="fp-peridot">Péridot</label>
              <input type="checkbox" id="fp-grenat" name="pierres" value="Grenat"><label for="fp-grenat">Grenat</label>
              <input type="checkbox" id="fp-nsp" name="pierres" value="À choisir ensemble"><label for="fp-nsp">À choisir ensemble</label>
            </div>
          </fieldset>
          <div class="field field-wide">
            <label for="f-inspi">Vos inspirations <span class="opt">(facultatif)</span></label>
            <p class="help" id="h-inspi">Une bague aperçue quelque part, une forme, une couleur, un lien vers une image.</p>
            <textarea id="f-inspi" name="contact[Inspirations]" aria-describedby="h-inspi" style="min-height:90px"></textarea>
          </div>
          <div class="field field-wide">
            <label for="f-inspi-img">Images d'inspiration <span class="opt">(facultatif, 6 au plus)</span></label>
            <input id="f-inspi-img" type="file" accept="image/*" multiple>
